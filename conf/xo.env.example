# ==============================================================================
# Xen Orchestra API Configuration Template
# Copy this file to site-conf/xo.env and fill in your Xen Orchestra credentials.
# Note: site-conf/ is git-ignored, so your API token stays private.
# ==============================================================================

# Xen Orchestra URL (e.g. https://xo.internal.lan or https://192.168.1.50)
XO_URL="https://xo.internal.lan"

# Xen Orchestra API Token
# Generate in XO web UI: Settings > Users > [Your User] > API Tokens
XO_TOKEN="your-api-token-here"

# Default Template Name or UUID (e.g. "Ubuntu Noble 24.04 Cloud" or "Debian 12 Cloud")
XO_TEMPLATE="Ubuntu Noble 24.04 Cloud"

# Storage Repository (SR) Name or UUID (e.g. "Local storage" or pool default)
XO_SR=""

# Network Name or UUID (e.g. "Pool-wide network associated with eth0")
XO_NETWORK=""

# VM Sizing Defaults
XO_VCPUS="1"
XO_MEMORY_MB="1024"
