# ==============================================================================
# Xen Orchestra Configuration Template (Used by admin/ca-vm-deploy.sh via xo-cli)
# Copy this file to site-conf/<site-id>/xo.env and fill in your Xen Orchestra credentials.
# Note: site-conf/ is git-ignored, so your API token stays private.
#
# Prerequisite: xo-cli (npm install -g xo-cli)
# ==============================================================================

# Xen Orchestra URL (e.g. https://xo.internal.lan or https://192.168.1.50)
XO_URL="https://xo.internal.lan"

# Xen Orchestra API Token
# Generate in XO web UI: Settings > Users > [Your User] > API Tokens
# Used by xo-cli as: https://<token>@<host>/
XO_TOKEN="your-api-token-here"

# Default Template Name or UUID (e.g. "Ubuntu 24.04 Cloud-Init (Hub)" or "Debian Bookworm 12")
# Run: ./admin/ca-vm-deploy.sh <site-id> --list to discover templates on your host.
XO_TEMPLATE="Ubuntu 24.04 Cloud-Init (Hub)"

# Storage Repository (SR) Name or UUID (e.g. "Local storage" or pool default)
XO_SR=""

# Network Name or UUID (e.g. "Pool-wide network associated with eth0")
XO_NETWORK=""

# VM Sizing Defaults
XO_VCPUS="1"
XO_MEMORY_MB="1024"
