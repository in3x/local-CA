# ==============================================================================
# Site Profile Template
# Copy this file to site-conf/<site-id>/site.env and customize for your site.
# ==============================================================================

# Passphrase Complexity & Cognitive Chunking
# Number of words from the EFF Large List (minimum 4, default: 4)
# Number of trailing digits (minimum 4, default: 7)
# When PASSPHRASE_DIGITS=7, digits are chunked as XXX-XXXX (phone number style) for cognitive ease.
# 4 words + 7 digits (e.g. word-word-word-word-123-4567) = ~75.0 bits of entropy (cold-storage grade)
# 4 words + 4 digits (e.g. word-word-word-word-1234)     = ~65.0 bits of entropy
PASSPHRASE_WORDS="4"
PASSPHRASE_DIGITS="7"

# Unique Initial Temporary Bootstrap Password
# Automatically generated per site. Single-use credential for first console/SSH login.
# Forcibly replaced with a permanent passphrase during the first-login security ceremony.
INITIAL_TEMP_PASSWORD="example-temporary-passphrase-000-0000"

# Unique identifier for this site / cluster (e.g. pw-dc, lab-home, branch-office)
SITE_ID="example-site"

# Organization metadata embedded in generated certificates
ORGANIZATION="Example Organization Inc."
COUNTRY="US"
LOCALITY="Dallas"
STATE="Texas"

# Root CA Attributes
ROOT_CA_NAME="Example Root CA"
ROOT_VALIDITY="175200h" # 20 years

# Intermediate CA Attributes
INTERMEDIATE_CA_NAME="Example Intermediate CA"
INTERMEDIATE_FQDN="ica.internal.example.com"
INTERMEDIATE_VALIDITY="26280h" # 3 years

# Certificate Policy Durations
# ACME certificates are kept short-lived to eliminate the need for revocation infrastructure
ACME_MIN_DURATION="1h"
ACME_DEFAULT_DURATION="24h"
ACME_MAX_DURATION="24h"

# Static / Non-ACME certificates generated for hardware, appliances, and legacy servers
STATIC_MIN_DURATION="1h"
STATIC_DEFAULT_DURATION="8760h" # 1 year
STATIC_MAX_DURATION="8760h"     # 1 year

# Network configuration for Intermediate VM (used during cloud-init / static IP assignment)
# Intermediate VM IP (leave empty if using DHCP reservation)
INTERMEDIATE_IP=""
INTERMEDIATE_GATEWAY=""
INTERMEDIATE_DNS="1.1.1.1 8.8.8.8"
