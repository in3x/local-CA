  - path: /etc/profile.d/99-first-login-ceremony.sh
    permissions: "0755"
    owner: root:root
    content: |
      # First-Time Login Security Ceremony
      if [ -n "$PS1" ] && [ "$(id -u)" -ne 0 ] && [ "${USER}" = "stepadmin" ]; then
        FLAG_FILE="/home/stepadmin/.password_configured"
        if [ ! -f "${FLAG_FILE}" ]; then
          PASS_FILE="/etc/step-ca/secrets/new_admin_password.txt"
          if [ ! -f "${PASS_FILE}" ]; then
            sudo mkdir -p /etc/step-ca/secrets
            # Generate an XKCD/Diceware passphrase with cognitive chunking (e.g. word-word-word-word-123-4567)
            PASSPHRASE_WORDS="${PASSPHRASE_WORDS:-4}"
            PASSPHRASE_DIGITS="${PASSPHRASE_DIGITS:-7}"
            WORD_LIST="/usr/local/share/dict/eff-words.txt"
            [ "${PASSPHRASE_WORDS}" -lt 4 ] 2>/dev/null && PASSPHRASE_WORDS=4
            [ "${PASSPHRASE_DIGITS}" -lt 4 ] 2>/dev/null && PASSPHRASE_DIGITS=4

            if [ -f "${WORD_LIST}" ] && command -v shuf &>/dev/null; then
              WORDS=$(shuf -n "${PASSPHRASE_WORDS}" "${WORD_LIST}" | tr '\n' '-' | sed 's/-$//')
              RAW_DIGITS=$(LC_ALL=C tr -dc '0-9' </dev/urandom | head -c "${PASSPHRASE_DIGITS}")
              if [ "${PASSPHRASE_DIGITS}" -eq 7 ]; then
                FORMATTED_DIGITS="${RAW_DIGITS:0:3}-${RAW_DIGITS:3:4}"
              else
                FORMATTED_DIGITS="${RAW_DIGITS}"
              fi
              echo "${WORDS}-${FORMATTED_DIGITS}" | sudo tee "${PASS_FILE}" >/dev/null
            else
              LC_ALL=C tr -dc 'A-Za-z0-9!#$%*+,-.:=?@^_' </dev/urandom | head -c 26 | sudo tee "${PASS_FILE}" >/dev/null
            fi
            sudo chmod 0600 "${PASS_FILE}"
          fi

          NEW_PW="$(sudo cat "${PASS_FILE}")"
          trap 'echo ""; echo "Security ceremony incomplete. Logging out."; exit 1' INT TERM HUP

          while true; do
            echo ""
            echo "========================================================================"
            echo " FIRST-TIME LOGIN SECURITY CEREMONY: STEPADMIN PASSWORD SETUP"
            echo "========================================================================"
            echo ""
            echo " A new cryptographically secure permanent password has been generated:"
            echo ""
            echo "   -->   ${NEW_PW}   <--"
            echo ""
            echo " INSTRUCTIONS:"
            echo " 1. Copy and store this password in an encrypted vault or password manager."
            echo " 2. Type 'captured' or 'got it' when you have safely saved it."
            echo "========================================================================"
            echo ""
            read -r -p "Confirmation: " confirm_input

            shopt -s nocasematch
            if [[ "${confirm_input}" == "captured" || "${confirm_input}" == "got it" ]]; then
              shopt -u nocasematch
              echo ""
              echo "Proof of capture required:"
              echo "Please re-type or paste the permanent password to verify:"
              read -r -s -p "Verify Password: " verify_input
              echo ""

              if [ "${verify_input}" == "${NEW_PW}" ]; then
                echo ""
                echo "Updating account password..."
                echo "stepadmin:${NEW_PW}" | sudo chpasswd
                sudo touch "${FLAG_FILE}"
                sudo rm -f "${PASS_FILE}"
                echo "[OK] Password successfully verified and updated."
                echo "Use your new permanent password for all future logins."
                echo ""
                sleep 2
                trap - INT TERM HUP
                break
              else
                echo ""
                echo "ERROR: Password does not match! Press Enter to try again."
                read -r
              fi
            else
              shopt -u nocasematch
              echo ""
              echo "You must enter 'captured' or 'got it' to proceed. Press Enter to retry."
              read -r
            fi
          done
        fi
      fi

  - path: /etc/sysctl.d/99-disable-ipv6.conf
    permissions: "0644"
    owner: root:root
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1

  - path: /usr/local/bin/init-root-ca.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      STEPPATH="${STEPPATH:-/etc/step-ca}"
      mkdir -p "${STEPPATH}/certs" "${STEPPATH}/secrets"
      chmod 0700 "${STEPPATH}" "${STEPPATH}/secrets"

      PASSPHRASE_WORDS="${PASSPHRASE_WORDS:-4}"
      PASSPHRASE_DIGITS="${PASSPHRASE_DIGITS:-7}"
      WORD_LIST="${WORD_LIST:-/usr/local/share/dict/eff-words.txt}"

      [ "${PASSPHRASE_WORDS}" -lt 4 ] 2>/dev/null && PASSPHRASE_WORDS=4
      [ "${PASSPHRASE_DIGITS}" -lt 4 ] 2>/dev/null && PASSPHRASE_DIGITS=4

      if [ -f "${STEPPATH}/certs/root_ca.crt" ]; then
        echo "ERROR: Root CA already initialized at ${STEPPATH}/certs/root_ca.crt"
        exit 1
      fi

      if [ -f "${WORD_LIST}" ] && command -v shuf &>/dev/null; then
        WORDS=$(shuf -n "${PASSPHRASE_WORDS}" "${WORD_LIST}" | tr '\n' '-' | sed 's/-$//')
        RAW_DIGITS=$(LC_ALL=C tr -dc '0-9' </dev/urandom | head -c "${PASSPHRASE_DIGITS}")
        if [ "${PASSPHRASE_DIGITS}" -eq 7 ]; then
          FORMATTED_DIGITS="${RAW_DIGITS:0:3}-${RAW_DIGITS:3:4}"
        else
          FORMATTED_DIGITS="${RAW_DIGITS}"
        fi
        SUGGESTED_PW="${WORDS}-${FORMATTED_DIGITS}"
      else
        SUGGESTED_PW=$(LC_ALL=C tr -dc 'A-Za-z0-9!#$%*+,-.:=?@^_' </dev/urandom | head -c 26)
      fi

      while true; do
        echo ""
        echo "========================================================================"
        echo " ROOT CA PRIVATE KEY PASSPHRASE CEREMONY"
        echo "========================================================================"
        echo ""
        echo " A cryptographically secure Master Root Passphrase has been generated:"
        echo ""
        echo "   -->   ${SUGGESTED_PW}   <--"
        echo ""
        echo " INSTRUCTIONS:"
        echo " 1. Copy and store this passphrase in an encrypted vault or password manager."
        echo " 2. (Optional) Write an emergency physical paper copy for cold safe storage."
        echo " 3. Type 'captured' or 'got it' when safely preserved."
        echo "========================================================================"
        echo ""
        read -r -p "Confirmation: " confirm_input

        shopt -s nocasematch
        if [[ "${confirm_input}" == "captured" || "${confirm_input}" == "got it" ]]; then
          shopt -u nocasematch
          echo ""
          echo "Proof of capture required:"
          echo "Please re-type or paste the Master Root Passphrase to verify:"
          read -r -s -p "Verify Passphrase: " verify_input
          echo ""

          if [ "${verify_input}" == "${SUGGESTED_PW}" ]; then
            echo ""
            echo "[OK] Master Root Passphrase verified. Creating Root CA..."
            break
          else
            echo ""
            echo "ERROR: Passphrase does not match! Press Enter to try again."
            read -r
          fi
        else
          shopt -u nocasematch
          echo ""
          echo "You must enter 'captured' or 'got it' to proceed. Press Enter to retry."
          read -r
        fi
      done

      TEMP_PW_FILE=$(mktemp)
      echo -n "${SUGGESTED_PW}" > "${TEMP_PW_FILE}"
      chmod 0600 "${TEMP_PW_FILE}"

      step certificate create "Paradigm Works Root CA" \
        "${STEPPATH}/certs/root_ca.crt" \
        "${STEPPATH}/secrets/root_ca_key" \
        --profile root-ca \
        --kty EC \
        --curve P-256 \
        --not-after 175200h \
        --password-file "${TEMP_PW_FILE}"

      shred -u "${TEMP_PW_FILE}" 2>/dev/null || rm -f "${TEMP_PW_FILE}"

      chmod 0644 "${STEPPATH}/certs/root_ca.crt"
      chmod 0600 "${STEPPATH}/secrets/root_ca_key"

      echo ""
      echo "[OK] Root CA successfully created."
      echo "Public Root Certificate: ${STEPPATH}/certs/root_ca.crt"
      echo "Root Private Key:        ${STEPPATH}/secrets/root_ca_key"
      echo ""
      step certificate inspect "${STEPPATH}/certs/root_ca.crt" --short

  - path: /usr/local/bin/sign-intermediate-csr.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      STEPPATH="${STEPPATH:-/etc/step-ca}"
      ROOT_CERT="${STEPPATH}/certs/root_ca.crt"
      ROOT_KEY="${STEPPATH}/secrets/root_ca_key"

      if [ $# -lt 1 ]; then
        echo "Usage: $0 <path-to-intermediate.csr> [validity-hours, default 26280h (3y)]"
        exit 1
      fi

      CSR_FILE="$1"
      VALIDITY="${2:-26280h}"
      OUTPUT_CERT="${CSR_FILE%.csr}.crt"

      if [ ! -f "${ROOT_CERT}" ] || [ ! -f "${ROOT_KEY}" ]; then
        echo "ERROR: Root CA not found. Run /usr/local/bin/init-root-ca.sh first."
        exit 1
      fi

      echo "Signing Intermediate CSR: ${CSR_FILE}"
      echo "Validity: ${VALIDITY}"

      step certificate sign "${CSR_FILE}" "${ROOT_CERT}" "${ROOT_KEY}" \
        --profile intermediate-ca \
        --not-after "${VALIDITY}" \
        --out "${OUTPUT_CERT}"

      echo ""
      echo "[OK] Intermediate certificate generated: ${OUTPUT_CERT}"
      echo ""
      step certificate inspect "${OUTPUT_CERT}" --short

runcmd:
  # Install Smallstep repository
  - mkdir -p /etc/apt/trusted.gpg.d
  - curl -fsSL https://packages.smallstep.com/smallstep.gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/smallstep.gpg
  - echo "deb [signed-by=/etc/apt/trusted.gpg.d/smallstep.gpg] https://packages.smallstep.com/debian-security/ stable main" > /etc/apt/sources.list.d/smallstep.list
  - apt-get update
  - apt-get install -y step-cli

  # Lock down firewall completely (deny all incoming)
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw --force enable

  # Create directories
  - mkdir -p /etc/step-ca/certs /etc/step-ca/secrets /root/ceremonies
  - chmod 0700 /etc/step-ca /etc/step-ca/secrets /root/ceremonies
